<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MifareOneTool.UI.ViewModels"
        x:Class="MifareOneTool.UI.Views.MainWindow"
        Title="MifareOneTool"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.Open}"    Command="{Binding OpenFileCommand}"      InputGesture="Ctrl+O"/>
                <MenuItem Header="{DynamicResource Menu.Save}"    Command="{Binding SaveFileCommand}"      InputGesture="Ctrl+S"/>
                <MenuItem Header="{DynamicResource Menu.SaveAs}"  Command="{Binding SaveAsFileCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.ImportMct}"    Command="{Binding ImportMctCommand}"/>
                <MenuItem Header="{DynamicResource Menu.ExportMct}"    Command="{Binding ExportMctCommand}"/>
                <MenuItem Header="{DynamicResource Menu.ExportKeyDict}" Command="{Binding ExportKeyDictCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.Exit}"    Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Tools}">
                <MenuItem Header="{DynamicResource Menu.HexTool}"  Command="{Binding OpenHexToolCommand}"/>
                <MenuItem Header="{DynamicResource Menu.Diff}"     Command="{Binding OpenDiffCommand}"/>
                <MenuItem Header="{DynamicResource Menu.HardNes}"  Command="{Binding OpenHardNesCommand}"/>
                <MenuItem Header="{DynamicResource Menu.Mff08}"    Command="{Binding OpenMff08Command}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.About}"       Command="{Binding AboutCommand}"/>
                <MenuItem Header="{DynamicResource Menu.CheckUpdate}" Command="{Binding CheckUpdateCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD" Padding="8,4">
            <TextBlock Text="{Binding StatusText}"/>
        </Border>

        <Grid ColumnDefinitions="220,*" RowDefinitions="*">
            <!-- Left panel -->
            <ScrollViewer Grid.Column="0" Margin="8">
                <StackPanel Spacing="8">

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Panel.Device}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Button Content="{DynamicResource Panel.ScanDevices}"
                                    Command="{Binding ScanDevicesCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Panel.ReadCard}" FontWeight="SemiBold"/>
                            <CheckBox Content="{DynamicResource Panel.AutoKeyAB}"  IsChecked="{Binding AutoABN}"/>
                            <Button Content="{DynamicResource Panel.ReadMfoc}"  Command="{Binding ReadMfocCommand}"  HorizontalAlignment="Stretch"/>
                            <Button Content="{DynamicResource Panel.ReadMfcuk}" Command="{Binding ReadMfcukCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Panel.WriteCard}" FontWeight="SemiBold"/>
                            <CheckBox Content="{DynamicResource Panel.WriteVerify}" IsChecked="{Binding WriteCheck}"/>
                            <Button Content="{DynamicResource Panel.WriteBlock0}" Command="{Binding WriteBlock0Command}" HorizontalAlignment="Stretch"/>
                            <Button Content="{DynamicResource Panel.WriteFull}"   Command="{Binding WriteFullCommand}"   HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Panel.UID}" FontWeight="SemiBold"/>
                            <TextBox Watermark="{DynamicResource Panel.UIDHint}" Text="{Binding UidText}"/>
                            <Button Content="{DynamicResource Panel.WriteUID}" Command="{Binding WriteUidCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Panel.Language}" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right panel: log -->
            <DockPanel Grid.Column="1" Margin="0,8,8,8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" Spacing="8">
                    <TextBlock Text="{DynamicResource Output.Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="{DynamicResource Output.Clear}" Command="{Binding ClearLogCommand}"/>
                </StackPanel>
                <ScrollViewer>
                    <TextBox Text="{Binding LogText}"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontFamily="Courier New,Consolas,monospace"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
