<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MifareOneTool.UI.ViewModels"
        x:Class="MifareOneTool.UI.Views.DiffWindow"
        Title="Diff"
        Width="700" Height="550"
        MinWidth="600" MinHeight="400">

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="BtnA" Content="Load A..." Command="{Binding LoadACommand}" MinWidth="120"/>
            <Button x:Name="BtnB" Content="Load B..." Command="{Binding LoadBCommand}" MinWidth="120"/>
            <Button Content="Compare" Command="{Binding CompareCommand}" MinWidth="90"/>
        </StackPanel>
        <ScrollViewer>
            <TextBox x:Name="ResultBox"
                     Text="{Binding ResultText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Courier New,Consolas,monospace"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Stretch"/>
        </ScrollViewer>
    </DockPanel>
</Window>
