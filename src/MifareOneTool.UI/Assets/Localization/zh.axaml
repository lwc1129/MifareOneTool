  <sys:String x:Key="Menu.Tools">工具</sys:String>
  <sys:String x:Key="Menu.HexTool">Hex 编辑器 (S50HTool)...</sys:String>
  <sys:String x:Key="Menu.Diff">比较...</sys:String>
  <sys:String x:Key="Menu.HardNes">Hard Nested 攻击...</sys:String>
