  <sys:String x:Key="Panel.Device">设备</sys:String>
  <sys:String x:Key="Panel.ScanDevices">扫描设备</sys:String>
  <sys:String x:Key="Panel.ReadCard">读取卡片</sys:String>
  <sys:String x:Key="Panel.AutoKeyAB">自动 KeyAB</sys:String>
  <sys:String x:Key="Panel.ReadMfoc">读取 (mfoc)</sys:String>
  <sys:String x:Key="Panel.ReadMfcuk">读取 (mfcuk)</sys:String>
  <sys:String x:Key="Panel.WriteCard">写入卡片</sys:String>
